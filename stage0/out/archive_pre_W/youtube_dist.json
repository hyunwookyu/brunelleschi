    {
      "vid": "zce-bbBSXJQ",
      "lang": "ko",
      "t": 471.479,
      "text": "하나는 한 18cm니까 하나 둘 셋"
    },
    {
      "vid": "zce-bbBSXJQ",
      "lang": "ko",
      "t": 667.019,
      "text": "있었죠 그러면 이제 2층으로 가면은"
