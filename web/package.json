{
  "name": "sketch2space-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "iPad 실시간 뷰어 — 파서 TS 포팅 (참조: python/, 지시서 V)",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dev": "vite",
    "dev:http": "node -e \"process.env.S2S_HTTP='1';require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['vite'],{stdio:'inherit',env:process.env})\"",
    "dev:5222": "node -e \"process.env.S2S_HTTP='1';require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['vite','--port','5222','--strictPort'],{stdio:'inherit',env:process.env})\"",
    "icons": "python tools/make_icons.py",
    "dev:e2e": "node -e \"process.env.S2S_HTTP='1';require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['vite','--port','5223','--strictPort'],{stdio:'inherit',env:process.env})\"",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.185.1",
    "vite": "^5.4.21"
  }
}
