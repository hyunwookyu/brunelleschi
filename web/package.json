{
  "name": "brunelleschi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Brunelleschi — 투시도와 입체를 동시에 보면서 실시간으로 입체를 만든다",
  "scripts": {
    "test": "vitest run",
    "test:unit": "node tools/testSplit.mjs unit",
    "test:measure": "node tools/testSplit.mjs measure",
    "test:split": "node tools/testSplit.mjs list",
    "test:cost": "node tools/testCost.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dev": "vite",
    "dev:http": "node -e \"process.env.S2S_HTTP='1';require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['vite'],{stdio:'inherit',env:process.env,shell:process.platform==='win32'})\"",
    "dev:5222": "node -e \"process.env.S2S_HTTP='1';require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['vite','--port','5222','--strictPort'],{stdio:'inherit',env:process.env,shell:process.platform==='win32'})\"",
    "icons": "python tools/make_icons.py",
    "dev:e2e": "node -e \"process.env.S2S_HTTP='1';require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['vite','--port','5223','--strictPort'],{stdio:'inherit',env:process.env,shell:process.platform==='win32'})\"",
    "e2e": "playwright test",
    "build:pages": "node -e \"process.env.S2S_BASE=process.env.S2S_BASE||'./';require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['vite','build'],{stdio:'inherit',env:process.env,shell:process.platform==='win32'})\"",
    "preview": "vite preview --port 4173"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.185.1",
    "vite": "^5.4.21"
  }
}
